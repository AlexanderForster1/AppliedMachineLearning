import cv2
import mediapipe as mp
import math
import random
import time
from ultralytics import YOLO

# ----- YOLO Model ----
model = YOLO(r"C:\Users\leona\runs\classify\anti_spoofing_yolo_with_aug_final01\weights\best.pt")

# ---- Face Mesh Model ----
# ref: https://github.com/google-ai-edge/mediapipe/blob/master/docs/solutions/face_mesh.md
# accessing mediapipe's face mesh module
mp_face_mesh = mp.solutions.face_mesh

# creates the Face Mesh detector and detect only 1 face
face_mesh = mp_face_mesh.FaceMesh(
    max_num_faces=1
)
# -------------------------

# FACE PART COORDINATES
# ref: https://www.sanderdesnaijer.com/blog/mediapipe-face-mesh-landmarks?utm_source
LEFT_EYE = [33, 159, 145, 133] #33 left outer corner, 159 top eyelid, 145 bottom eyelid, 133 right inner corner
RIGHT_EYE = [362, 386, 374, 263]
NOSE = 4
LEFT_FACE = 234
RIGHT_FACE = 454


# DISTANCE FUNCTION BETWEEN UPPER EYE LID AND LOWER EYE LID
def distance(point1, point2):
    return math.sqrt(
        (point1.x - point2.x) ** 2 +
        (point1.y - point2.y) ** 2
    )

# PUT TEXT ON CAM FUCNTION
def text_on_cam(text, next):
    output = cv2.putText(
                frame,
                text,
                (30, 50 + next),
                cv2.FONT_HERSHEY_SIMPLEX,
                1,
                (0, 255, 0),
                2
            )
    return output


# Defining Challenge
challenges = ["Blink Twice", "Turn head left", "Turn head right"]
ran_challenge = random.choice(challenges)

